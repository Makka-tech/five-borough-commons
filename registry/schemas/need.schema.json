{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "needs-clarification",
        "researching",
        "validated-need",
        "project-candidate",
        "accepted-for-incubation",
        "not-suitable-for-software",
        "merged-with-existing-work",
        "closed-with-resources"
      ]
    },
    "demo": {
      "type": "boolean"
    },
    "whatIsHappening": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "whoIsAffected": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "boroughs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["Manhattan", "Brooklyn", "Queens", "The Bronx", "Staten Island", "Citywide"]
      }
    },
    "neighborhoods": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "currentWorkaround": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "possibleHelp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "publicSources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https:\\/\\/.*"
      }
    },
    "submitterWantsToParticipate": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "demo",
    "whatIsHappening",
    "whoIsAffected",
    "boroughs",
    "currentWorkaround",
    "possibleHelp",
    "publicSources",
    "submitterWantsToParticipate",
    "createdAt"
  ],
  "additionalProperties": false
}
